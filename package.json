{
  "name": "artboards-design",
  "description": "A harness-agnostic UI design tool built for coding agents.",
  "keywords": [
    "design",
    "ui",
    "react",
    "prototype",
    "cli",
    "agent"
  ],
  "type": "module",
  "version": "0.0.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unixzii/artboards.git"
  },
  "homepage": "https://artboards.cy4n.dev",
  "bugs": {
    "url": "https://github.com/unixzii/artboards/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "artboards": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.ts",
    "build:site": "npm run -s build && node scripts/build-site.ts",
    "typecheck": "tsc --noEmit -p src/shared && tsc --noEmit && tsc --noEmit -p src/viewer",
    "check": "npm run -s typecheck && npm run -s build && node scripts/lint-examples.ts",
    "dev": "node --watch-path=src scripts/dev.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.1.0",
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@types/react": "^19.3.0",
    "canvaskit-wasm": "^0.42.0",
    "commander": "^15.1.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.1",
    "react-reconciler": "^0.34.0",
    "taffy-layout": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react-dom": "^19.3.0",
    "@types/react-reconciler": "^0.34.1",
    "lucide-react": "^1.73.0",
    "react-dom": "^19.3.1"
  }
}
