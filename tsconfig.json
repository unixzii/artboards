{
  // Node side: shared contracts, engine, review server, and CLI. No DOM types, so browser globals are errors here.
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["esnext"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/shared", "src/engine", "src/server", "src/cli"]
}
